# --- Required -------------------------------------------------------------
# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Admin console ----------------------------------------------------------
# Password for the "admin" user at /admin (applied on every start).
ADMIN_PASSWORD=choose-a-strong-password
# Signs admin login sessions. Any long random string; keep it stable so logins survive restarts.
JWT_SECRET=replace-with-a-long-random-string
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# --- Optional ---------------------------------------------------------------
PORT=8000
# Primary model (also reads screenshots for Screen Assist) and instant fallbacks used when it is
# rate-limited. Each Groq model has its own per-minute token quota.
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
EMBED_MODEL=BAAI/bge-small-en-v1.5

# No longer used: retrieval now runs locally (Qdrant Cloud is not needed).
# QDRANT_URL=
# QDRANT_API_KEY=
